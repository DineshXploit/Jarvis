# JARVIS configuration
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# The NVIDIA API key is read only by the Electron main process, the cloud
# backend, and the desktop speech worker. It is never sent to the renderer.

# --- NVIDIA LLM ----------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# --- NVIDIA speech (cloud speech NIMs over gRPC) --------------------------
# Desktop only. The cloud backend does not carry speech: microphone, speaker
# and the NVCF worker stay on the Windows client.
NVIDIA_ASR_FUNCTION=ai-nemotron-asr-streaming
NVIDIA_TTS_FUNCTION=ai-magpie-tts-multilingual
VOICE_TTS_ID=Magpie-Multilingual.EN-US.Aria
NVCF_PORT=8758

# --- Web search ----------------------------------------------------------
SEARXNG_URL=http://localhost:8080

# --- Cloud backend -------------------------------------------------------
# Port for the cloud HTTP API. Ignored by the desktop app.
# Render injects PORT=10000 automatically and discovers the bound port from
# outside the container, so leave this unset on Render. Set 3000 only for local
# `docker run`.
# PORT=3000

# Bind address. 0.0.0.0 is required inside a container: binding loopback makes
# the service unreachable from the platform router.
HOST=0.0.0.0

# Desktop client: where to find the cloud backend. Leave EMPTY to keep the
# current fully-local mode, where the Electron main process owns chat, routing
# and speech. Set it to a Render (or other) URL to route conversation through
# the cloud while PC control, microphone and speaker remain local.
JARVIS_BACKEND_URL=

# --- Observability -------------------------------------------------------
# debug | info | warn | error. debug writes every telemetry event to disk.
TELEMETRY_LEVEL=info